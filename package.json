{
  "name": "@nodrel-dev/n8n-nodes-ups",
  "version": "0.7.3",
  "description": "n8n community node for UPS: rating, tracking, and address validation via the UPS REST API.",
  "license": "MIT",
  "homepage": "https://github.com/nodrel-dev/n8n-ups-node",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "nodrel-dev",
    "email": "kyletully317@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nodrel-dev/n8n-ups-node.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/UpsOAuth2Api.credentials.js",
      "dist/credentials/UpsShipperProfileApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Ups/Ups.node.js"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@n8n/node-cli": "^0.50.3",
    "@types/node": "^22.20.4",
    "eslint": "9.32.0",
    "lefthook": "^2.1.15",
    "n8n-workflow": "^2.41.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
